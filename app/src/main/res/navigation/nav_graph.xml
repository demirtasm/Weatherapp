<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboarding_nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.madkit.weatherapp.views.fragments.SplashFragment">
        <action
            android:id="@+id/action_splashFragment_to_viewPagerFragment"
            app:destination="@id/viewPagerFragment" />
        <action
            android:id="@+id/action_splashFragment_to_weatherMainFragment"
            app:destination="@id/weatherMainFragment" />
    </fragment>

    <fragment
        android:id="@+id/viewPagerFragment"
        android:name="com.madkit.weatherapp.views.fragments.onboarding.ViewPagerFragment">
        <action
            android:id="@+id/action_viewPagerFragment_to_splashFragment"
            app:destination="@id/splashFragment" />
    </fragment>
    <fragment
        android:id="@+id/weatherMainFragment"
        android:name="com.madkit.weatherapp.views.fragments.WeatherMainFragment"
        android:label="fragment_weather_main"
        tools:layout="@layout/fragment_weather_main" >
        <action
            android:id="@+id/action_weatherMainFragment_to_todayFragment"
            app:destination="@id/todayFragment" />
        <action
            android:id="@+id/action_weatherMainFragment_to_splashFragment"
            app:destination="@id/splashFragment"
            app:popUpTo="@id/weatherMainFragment"
            app:popUpToInclusive="true" />

    </fragment>
    <fragment
        android:id="@+id/todayFragment"
        android:name="com.madkit.weatherapp.views.fragments.TodayFragment"
        android:label="fragment_today"
        tools:layout="@layout/fragment_base_weather" >

        <action
            android:id="@+id/action_todayFragment_to_tomorrowFragment"
            app:destination="@id/tomorrowFragment" />
    </fragment>
    <fragment
        android:id="@+id/tomorrowFragment"
        android:name="com.madkit.weatherapp.views.fragments.TomorrowFragment"
        android:label="fragment_tomorrow"
        tools:layout="@layout/fragment_base_weather" >
        <action
            android:id="@+id/action_tomorrowFragment_to_oneWeekFragment"
            app:destination="@id/oneWeekFragment" />
    </fragment>
    <fragment
        android:id="@+id/oneWeekFragment"
        android:name="com.madkit.weatherapp.views.fragments.OneWeekFragment"
        android:label="fragment_one_week"
        tools:layout="@layout/fragment_one_week" />
</navigation>