<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="@color/background_content_color"
    tools:context=".views.fragments.WeatherMainFragment">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            app:contentScrim="@color/background_content_color"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="false">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/appBarBackground"
                android:layout_width="match_parent"
                android:layout_height="@dimen/toolbar_height"
                android:background="@android:color/transparent"
                android:scaleType="centerCrop"
                android:src="@drawable/header_background"
                app:layout_collapseMode="parallax"
                app:shapeAppearanceOverlay="@style/AppBarRoundedBottomCorners" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/padding_medium"
                android:fitsSystemWindows="true"
                app:layout_collapseMode="parallax">


                <ImageView
                    android:id="@+id/searchIcon"
                    android:layout_width="@dimen/ic_size_medium"
                    android:layout_height="@dimen/ic_size_medium"
                    android:visibility="invisible"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_search" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:gravity="end"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
                            android:id="@+id/tvDayText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/day_txt"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/medium_text_size" />

                        <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
                            android:id="@+id/tvDayTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/padding_xsmall"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/medium_text_size"
                            tools:text="3°" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
                            android:id="@+id/tvNightText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/night_txt"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/medium_text_size" />

                        <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
                            android:id="@+id/tvNightTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/padding_xsmall"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/medium_text_size"
                            tools:text="-1°" />
                    </LinearLayout>


                </LinearLayout>


                <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
                    android:id="@+id/dateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="@dimen/margin_small"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/medium_text_size"
                    tools:text="Nisan 07, 15:35" />

            </RelativeLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:title="">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/padding_medium"
                    app:layout_collapseMode="parallax">

                    <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Beykoz, TR"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/large_text_size" />

                    <com.madkit.weatherapp.views.customViews.customTextViewFont.InterBoldTextView
                        android:id="@+id/tvTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvName"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/xxlarge_text_size"
                        tools:text="3°" />

                    <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
                        android:id="@+id/tvFeelsLike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvTemp"
                        android:layout_alignStart="@id/tvTemp"
                        android:layout_marginTop="@dimen/margin_xsmall"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/medium_text_size"
                        tools:text="Feels Like 2°" />

                    <LinearLayout
                        android:id="@+id/weatherInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBottom="@id/tvFeelsLike"
                        android:layout_alignParentEnd="true"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivMain"
                            android:layout_width="@dimen/ic_size_xxlarge"
                            android:layout_height="@dimen/ic_size_xxlarge"
                            android:layout_gravity="center"
                            tools:src="@drawable/ic_clear_day" />

                        <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
                            android:id="@+id/tvMain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:autoSizeMaxTextSize="@dimen/medium_text_size"
                            android:autoSizeMinTextSize="@dimen/small_text_size"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/medium_text_size"
                            tools:text="Cloud" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <LinearLayout
            android:id="@+id/weatherTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_content_color"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/padding_small"
            app:layout_collapseMode="pin">

            <Button
                android:id="@+id/btnToday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/active_button_color"
                android:text="@string/today_txt"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/btnTomorrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_xsmall"
                android:layout_marginEnd="@dimen/margin_xsmall"
                android:layout_weight="1"
                android:backgroundTint="@color/default_button_color"
                android:text="@string/tomorrow_txt"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/btn1Week"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/default_button_color"
                android:text="@string/btn_one_week_txt"
                android:textColor="@color/black" />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainerView"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:navGraph="@navigation/nav_graph" />
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>