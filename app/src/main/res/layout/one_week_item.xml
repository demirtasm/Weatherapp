<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:backgroundTint="#E8DFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/textDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="Today"
            android:textColor="#000000"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textWeatherDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="Cloudy and Sunny"
            android:textColor="#444444"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textDay" />

        <TextView
            android:id="@+id/textTempMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/inter_bold"
            android:text="3°"
            android:textColor="#2B0056"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tempDivider"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textTempMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="-2°"
            android:textColor="#2B0056"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            app:layout_constraintEnd_toEndOf="@id/tempDivider"
            app:layout_constraintStart_toStartOf="@id/textTempMax"
            app:layout_constraintTop_toBottomOf="@id/textTempMax" />

        <View
            android:id="@+id/tempDivider"
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#2B0056"
            app:layout_constraintBottom_toBottomOf="@id/textTempMin"
            app:layout_constraintEnd_toStartOf="@id/imageWeather"
            app:layout_constraintTop_toTopOf="@id/textTempMax" />

        <ImageView
            android:id="@+id/imageWeather"
            android:layout_width="@dimen/ic_size_mega"
            android:layout_height="@dimen/ic_size_mega"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toLeftOf="@id/tempDivider"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>