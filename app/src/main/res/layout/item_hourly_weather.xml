<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="@dimen/padding_xsmall">
    <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
        android:id="@+id/textTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="-"
        android:layout_gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/small_text_size" />

        <ImageView
            android:id="@+id/iv_weather_code"
            android:layout_width="@dimen/ic_size_medium"
            android:layout_height="@dimen/ic_size_medium"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:contentDescription="@string/image_contentDescription"
            app:srcCompat="@drawable/ic_clear_day" />
        <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
            android:id="@+id/textTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="-"
            android:layout_gravity="center"
            android:textColor="@color/primary_text_color"
            android:textSize="@dimen/medium_text_size"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/iv_sunset"
            android:layout_width="@dimen/ic_size_min"
            android:layout_height="@dimen/ic_size_min"
            android:layout_gravity="center"
            android:clipChildren="false"
            app:srcCompat="@drawable/ic_union" />
        <com.madkit.weatherapp.views.customViews.customTextViewFont.InterTextView
            android:id="@+id/textRain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_text_color"
            android:textSize="@dimen/medium_text_size"/>
    </LinearLayout>

</LinearLayout>