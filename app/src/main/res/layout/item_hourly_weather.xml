<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="8dp">
    <TextView
        android:id="@+id/textTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:layout_gravity="center"
        android:textColor="@color/black"
        android:textSize="10sp"
        android:fontFamily="@font/inter" />

        <ImageView
            android:id="@+id/iv_weather_code"
            android:layout_width="@dimen/ic_size_medium"
            android:layout_height="@dimen/ic_size_medium"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:contentDescription="@string/image_contentDescription"
            app:srcCompat="@drawable/ic_clear_day" />
        <TextView
            android:id="@+id/textTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:fontFamily="@font/inter"
            android:layout_gravity="center"
            android:textColor="@color/black"
            android:textSize="14sp"/>



    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/iv_sunset"
            android:layout_width="@dimen/ic_size_min"
            android:layout_height="@dimen/ic_size_min"
            android:layout_gravity="center"
            android:clipChildren="false"
            app:srcCompat="@drawable/ic_union" />
        <TextView
            android:id="@+id/textRain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textColor="@color/black"
            android:textSize="14sp"/>
    </LinearLayout>

</LinearLayout>